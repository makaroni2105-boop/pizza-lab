{
  "name": "pizza-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:staging": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview -c wrangler.staging.toml",
    "validate:staging-config": "node scripts/validate-staging-wrangler.mjs",
    "validate:production-config": "node scripts/validate-production-wrangler.mjs",
    "validate:production-go-live": "node scripts/validate-production-go-live.mjs",
    "deploy:production:phase0": "opennextjs-cloudflare deploy --config wrangler.toml",
    "deploy:staging": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy -c wrangler.staging.toml",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.0"
  }
}
